{
  "swagger": "2.0",
  "info": {
    "title": "UPI BACKEND API",
    "version": "1.0.0",
    "description": "API documentation for the PhonePe Backend System built with MERN stack"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Health check endpoint",
        "responses": {
          "200": {
            "description": "UPI Backend is running"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Register user",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "name",
                "email",
                "phone",
                "password"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Aviral"
                },
                "email": {
                  "type": "string",
                  "example": "aviral@gmail.com"
                },
                "phone": {
                  "type": "string",
                  "example": "9876543210"
                },
                "password": {
                  "type": "string",
                  "example": "123456"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "User registered successfully"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login user",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "email",
                "password"
              ],
              "properties": {
                "email": {
                  "type": "string",
                  "example": "aviral@gmail.com"
                },
                "password": {
                  "type": "string",
                  "example": "123456"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login successful"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Invalid email or password"
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
    "/api/auth/set-mpin": {
      "post": {
        "summary": "Set MPIN",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "Bearer token"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "mpin"
              ],
              "properties": {
                "mpin": {
                  "type": "string",
                  "example": "1234"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "MPIN set successfully"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/auth/profile": {
      "get": {
        "summary": "Get user profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User profile"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/transactions/send": {
      "post": {
        "summary": "Send money",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "phone",
                "amount",
                "mpin"
              ],
              "properties": {
                "phone": {
                  "type": "string",
                  "example": "9876543210"
                },
                "amount": {
                  "type": "number",
                  "example": 100
                },
                "mpin": {
                  "type": "string",
                  "example": "1234"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Money transfer successful"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Receiver not found"
          }
        }
      }
    },
    "/api/transactions/history": {
      "get": {
        "summary": "Get transaction history",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction history"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/wallet/add-money": {
      "post": {
        "summary": "Add money to wallet",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "amount"
              ],
              "properties": {
                "amount": {
                  "type": "number",
                  "example": 500
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Money added successfully"
          },
          "400": {
            "description": "Invalid amount"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/wallet/pay-bill": {
      "post": {
        "summary": "Pay utility bill",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "amount",
                "mpin"
              ],
              "properties": {
                "billerName": {
                  "type": "string",
                  "example": "DPC"
                },
                "amount": {
                  "type": "number",
                  "example": 100
                },
                "mpin": {
                  "type": "string",
                  "example": "1234"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bill paid successfully"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Enter token in format Bearer <token>"
    }
  }
}